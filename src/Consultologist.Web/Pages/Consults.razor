    string JobId,
    string BlockId,
    string Text);

  private sealed record ConsultGenerationBlockFailedEvent(
    string JobId,
    string BlockId,
    string Error);

  private sealed record ConsultGenerationNodeCompletedEvent(
    string JobId,
    string NodeId,
    string Label,
    string Message,
    int CompletedNodeCount,
